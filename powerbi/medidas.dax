// =====================================================================
// Medidas do modelo "Produção Comercial" (Power BI)
// Fonte: MARTS.PRODUCAO_X_META (Snowflake) ou data/marts/producao_x_meta.parquet
// Relacionamentos: dCalendario[Data] 1:* fProducaoMeta[MES]
//                  dAgencia[AGENCIA_ID] 1:* fProducaoMeta[AGENCIA_ID]
//                  dProduto[PRODUTO_ID] 1:* fProducaoMeta[PRODUTO_ID]
// =====================================================================

// ---------- Base ----------
Produção = SUM ( fProducaoMeta[PRODUCAO] )

Meta = SUM ( fProducaoMeta[META] )

Contratos = SUM ( fProducaoMeta[CONTRATOS] )

Produção Digital = SUM ( fProducaoMeta[PRODUCAO_DIGITAL] )

// ---------- Meta ----------
Atingimento % = DIVIDE ( [Produção], [Meta] )

Gap para a Meta = [Produção] - [Meta]

Status da Meta =
SWITCH (
    TRUE (),
    ISBLANK ( [Atingimento %] ), BLANK (),
    [Atingimento %] >= 1, "Acima da meta",
    [Atingimento %] >= 0.9, "Entre 90% e 100%",
    "Abaixo de 90%"
)

// Cor por status (formatação condicional por "valor do campo")
Cor do Status =
SWITCH (
    TRUE (),
    [Atingimento %] >= 1, "#0CA30C",
    [Atingimento %] >= 0.9, "#FAB219",
    "#D03B3B"
)

// ---------- Indicadores ----------
Ticket Médio = DIVIDE ( [Produção], [Contratos] )

% Digital = DIVIDE ( [Produção Digital], [Produção] )

Taxa Média Ponderada a.m. =
DIVIDE (
    SUMX ( fProducaoMeta, fProducaoMeta[PRODUCAO] * fProducaoMeta[TAXA_MEDIA_PONDERADA] ),
    CALCULATE ( [Produção], NOT ISBLANK ( fProducaoMeta[TAXA_MEDIA_PONDERADA] ) )
)

// ---------- Inteligência de tempo ----------
Produção YTD = TOTALYTD ( [Produção], dCalendario[Data] )

Meta YTD = TOTALYTD ( [Meta], dCalendario[Data] )

Atingimento YTD % = DIVIDE ( [Produção YTD], [Meta YTD] )

Produção Ano Anterior = CALCULATE ( [Produção], SAMEPERIODLASTYEAR ( dCalendario[Data] ) )

Variação a/a % = DIVIDE ( [Produção] - [Produção Ano Anterior], [Produção Ano Anterior] )

Produção Últimos 12 Meses =
CALCULATE (
    [Produção],
    DATESINPERIOD ( dCalendario[Data], MAX ( dCalendario[Data] ), -12, MONTH )
)

% Digital Variação p.p. =
[% Digital] - CALCULATE ( [% Digital], SAMEPERIODLASTYEAR ( dCalendario[Data] ) )

// ---------- Participação e ranking ----------
Participação no Total =
DIVIDE ( [Produção], CALCULATE ( [Produção], ALLSELECTED ( dProduto ) ) )

Ranking Regional por Atingimento =
IF (
    HASONEVALUE ( dAgencia[REGIONAL] ),
    RANKX ( ALLSELECTED ( dAgencia[REGIONAL] ), [Atingimento %], , DESC, DENSE )
)

Ranking Agência por Produção =
IF (
    HASONEVALUE ( dAgencia[AGENCIA] ),
    RANKX ( ALLSELECTED ( dAgencia[AGENCIA] ), [Produção], , DESC, DENSE )
)

// ---------- Textos dinâmicos (títulos e storytelling) ----------
Título do Período =
VAR _ini = MIN ( dCalendario[Data] )
VAR _fim = MAX ( dCalendario[Data] )
RETURN FORMAT ( _ini, "mmm/yyyy" ) & " – " & FORMAT ( _fim, "mmm/yyyy" )

Resumo Executivo =
VAR _prod = [Produção]
VAR _at = [Atingimento %]
VAR _gap = [Gap para a Meta]
RETURN
    "A produção somou " & FORMAT ( _prod / 1e6, "#,0.0" ) & " mi, "
        & FORMAT ( _at, "0.0%" ) & " da meta"
        & IF ( _gap >= 0,
               " (" & FORMAT ( _gap / 1e6, "#,0.0" ) & " mi acima do planejado).",
               " (faltam " & FORMAT ( -_gap / 1e6, "#,0.0" ) & " mi)." )

Regional com Menor Atingimento =
VAR _t =
    ADDCOLUMNS ( VALUES ( dAgencia[REGIONAL] ), "@at", [Atingimento %] )
RETURN
    MINX ( TOPN ( 1, _t, [@at], ASC ), dAgencia[REGIONAL] )
